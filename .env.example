# Application Runtime Configuration Map
PORT=5000
NODE_ENV=development

# Cloud Persistence Layer Storage Pointers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tashi_shop?retryWrites=true&w=majority

# Local Core Cache Memory Cluster
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Symmetric Cryptographic Signed Passphrases
JWT_SECRET=your_super_secret_64_character_hexadecimal_string_key_here
JWT_EXPIRES_IN=1d